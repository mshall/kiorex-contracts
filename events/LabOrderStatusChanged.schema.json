{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/LabOrderStatusChanged.schema.json",
  "title": "LabOrderStatusChanged",
  "description": "Derived order status moved (only for KIOREX_BOOKING / KIORLY_CLINIC orders). Event id is deterministic per (order, nextStatus). Draft (NH-LB-025).",
  "x-producer": "kiorly-lab",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "LabOrderStatusChanged"
    },
    "aggregateType": {
      "const": "LabOrder"
    },
    "data": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "orderNumber": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "KIOREX_BOOKING",
            "KIORLY_CLINIC"
          ]
        },
        "originEdition": {
          "enum": [
            "NURSE"
          ],
          "description": "Present when the order was collected by Kiorly Nurse (KIORLY_NURSE inbound client); source stays KIORLY_CLINIC (ADR-031). Additive in 1.6.0."
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "previousStatus": {
          "enum": [
            "DRAFT",
            "AWAITING_COLLECTION",
            "COLLECTED",
            "IN_LAB",
            "PARTIALLY_RESULTED",
            "AWAITING_VALIDATION",
            "VALIDATED",
            "RELEASED",
            "CANCELLED"
          ]
        },
        "nextStatus": {
          "enum": [
            "DRAFT",
            "AWAITING_COLLECTION",
            "COLLECTED",
            "IN_LAB",
            "PARTIALLY_RESULTED",
            "AWAITING_VALIDATION",
            "VALIDATED",
            "RELEASED",
            "CANCELLED"
          ]
        }
      },
      "required": [
        "orderId",
        "orderNumber",
        "source",
        "previousStatus",
        "nextStatus"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
