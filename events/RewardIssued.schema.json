{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/RewardIssued.schema.json",
  "title": "RewardIssued",
  "description": "INTERNAL. Reward ledger event RewardIssued (append-only ledger; rewards are funded by the platform marketing budget, never charged to providers, never change an attribution decision). Opaque lot reference, mode and amount only (1.12.0).",
  "x-producer": "kiorex",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "RewardIssued"
    },
    "aggregateType": {
      "const": "RewardLot"
    },
    "data": {
      "type": "object",
      "properties": {
        "lotRef": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "mode": {
          "enum": [
            "CREDIT",
            "COUPON"
          ]
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^rwd:[a-z0-9_-]{1,40}:[A-Za-z0-9_-]{1,64}$",
          "description": "Format rwd:<entry type lower case>:<opaque id>."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "lotRef",
        "mode",
        "amountMinor",
        "currency",
        "reasonCode",
        "idempotencyKey",
        "at"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
