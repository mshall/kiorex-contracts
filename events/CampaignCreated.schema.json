{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/CampaignCreated.schema.json",
  "title": "CampaignCreated",
  "description": "INTERNAL (Kiorex outbox only). An ops user created a campaign plan (never an ad-platform object). Ids, market, channel labels and budget figures only: no patient data (1.12.0).",
  "x-producer": "kiorex",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "CampaignCreated"
    },
    "aggregateType": {
      "const": "GrowthCampaign"
    },
    "data": {
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
        },
        "objective": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
          },
          "maxItems": 12
        },
        "budgetTotalMinor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "campaignId",
        "market",
        "key",
        "objective",
        "budgetTotalMinor",
        "currency"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
