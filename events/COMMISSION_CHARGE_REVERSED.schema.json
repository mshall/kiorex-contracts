{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/COMMISSION_CHARGE_REVERSED.schema.json",
  "title": "COMMISSION_CHARGE_REVERSED",
  "description": "Commission charge reversed (check-in reverted, dispute upheld, etc.).",
  "x-producer": "kiorly-clinic",
  "x-status": "emitted",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "COMMISSION_CHARGE_REVERSED"
    },
    "aggregateType": {
      "const": "Appointment"
    },
    "data": {
      "type": "object",
      "properties": {
        "chargeId": {
          "type": "string",
          "minLength": 1
        },
        "appointmentId": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,2})?$",
          "description": "Decimal string, 2 dp."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "status": {
          "enum": [
            "PENDING",
            "CONFIRMED",
            "DISPUTED",
            "REVERSED",
            "WAIVED",
            "BILLED"
          ]
        },
        "attendedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decisionRef": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the Kiorex AttributionDecision (or the Clinic CommissionDecision) that explains the outcome. Additive in 1.10.0."
        },
        "origin": {
          "enum": [
            "PROVIDER_LED",
            "MARKETPLACE",
            "UNATTRIBUTED"
          ],
          "description": "Commission-relevant acquisition origin decided by the Kiorex attribution function (additive in 1.10.0). Absent = UNATTRIBUTED and today's rules apply."
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Version id of the ATTRIBUTION_POLICY config that was ACTIVE at decision time. Additive in 1.10.0."
        },
        "reason": {
          "type": "string"
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "chargeId",
        "appointmentId",
        "amount",
        "currency",
        "status",
        "attendedAt",
        "reason"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
