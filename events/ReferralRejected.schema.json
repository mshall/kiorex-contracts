{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/ReferralRejected.schema.json",
  "title": "ReferralRejected",
  "description": "INTERNAL. A referral failed a check or expired. Machine reason code only (1.12.0).",
  "x-producer": "kiorex",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "ReferralRejected"
    },
    "aggregateType": {
      "const": "ReferralRelationship"
    },
    "data": {
      "type": "object",
      "properties": {
        "relationshipRef": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "rejectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "relationshipRef",
        "reasonCode",
        "rejectedAt"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
