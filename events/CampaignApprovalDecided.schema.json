{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/CampaignApprovalDecided.schema.json",
  "title": "CampaignApprovalDecided",
  "description": "INTERNAL. A second ops user approved or rejected a campaign activation, budget increase or reactivation (maker-checker). The decider is never the requester (1.12.0).",
  "x-producer": "kiorex",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "CampaignApprovalDecided"
    },
    "aggregateType": {
      "const": "GrowthCampaign"
    },
    "data": {
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ACTIVATE",
            "BUDGET_INCREASE",
            "REACTIVATE"
          ]
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "campaignId",
        "approvalId",
        "kind",
        "decision",
        "decidedAt"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
