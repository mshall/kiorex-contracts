{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/CampaignStatusChanged.schema.json",
  "title": "CampaignStatusChanged",
  "description": "INTERNAL. A campaign moved between states (DRAFT, PENDING_APPROVAL, SCHEDULED, ACTIVE, PAUSED, COMPLETED, ARCHIVED). One event per transition, idempotent on (campaignId, to, at). Reason code only, never free text about people (1.12.0).",
  "x-producer": "kiorex",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "CampaignStatusChanged"
    },
    "aggregateType": {
      "const": "GrowthCampaign"
    },
    "data": {
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "from": {
          "enum": [
            "DRAFT",
            "PENDING_APPROVAL",
            "SCHEDULED",
            "ACTIVE",
            "PAUSED",
            "COMPLETED",
            "ARCHIVED"
          ]
        },
        "to": {
          "enum": [
            "DRAFT",
            "PENDING_APPROVAL",
            "SCHEDULED",
            "ACTIVE",
            "PAUSED",
            "COMPLETED",
            "ARCHIVED"
          ]
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "actorKind": {
          "enum": [
            "USER",
            "SYSTEM"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "campaignId",
        "from",
        "to",
        "reasonCode",
        "at"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
