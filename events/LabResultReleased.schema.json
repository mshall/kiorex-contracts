{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/LabResultReleased.schema.json",
  "title": "LabResultReleased",
  "description": "Authorized lab report released. Carries the signed report version and a secure link only, never raw result values (KLCRIT03).",
  "x-producer": "kiorly-lab",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "LabResultReleased"
    },
    "aggregateType": {
      "const": "LabReport"
    },
    "data": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "minLength": 1
        },
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "labId": {
          "type": "string",
          "minLength": 1
        },
        "patientRef": {
          "type": "string",
          "minLength": 1
        },
        "reportVersion": {
          "type": "integer",
          "minimum": 1
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "secureLink": {
          "type": "string",
          "format": "uri"
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "PATIENT_LINK",
              "KIOREX_VAULT",
              "KIORLY_CLINIC",
              "PRINTED"
            ]
          }
        },
        "values": false,
        "results": false
      },
      "required": [
        "reportId",
        "orderId",
        "labId",
        "patientRef",
        "reportVersion",
        "signedAt",
        "secureLink"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
