{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/SeoVitalBudgetBreached.schema.json",
  "title": "SeoVitalBudgetBreached",
  "description": "INTERNAL (Kiorex outbox only). A Core Web Vitals p75 (lab or field) of a template went over its budget from SEO_AUTOMATION.vitals. Template kind, metric, source and the p75 only. Blocks nothing in code (1.13.0).",
  "x-producer": "kiorex",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "SeoVitalBudgetBreached"
    },
    "aggregateType": {
      "const": "SeoVital"
    },
    "data": {
      "type": "object",
      "properties": {
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "templateKind": {
          "type": "string",
          "maxLength": 40
        },
        "metric": {
          "enum": [
            "lcpMs",
            "inpMs",
            "cls",
            "tbtMs",
            "perfScore"
          ]
        },
        "source": {
          "enum": [
            "LAB",
            "FIELD"
          ]
        },
        "p75": {
          "type": "number"
        },
        "budget": {
          "type": "number"
        },
        "day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 10
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "market",
        "templateKind",
        "metric",
        "source",
        "p75",
        "day"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
