          "type": [
            "string",
            "null"
          ]
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "appointmentId",
        "clinicId"
      ]
    }
  },
  "required": [
