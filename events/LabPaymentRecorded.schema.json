{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/LabPaymentRecorded.schema.json",
  "title": "LabPaymentRecorded",
  "description": "A payment was recorded at the lab against a KIOREX_BOOKING order invoice (cash or card). Amount is a decimal in major units. Lab-side ledger only; never commingled with Kiorex Pay.",
  "x-producer": "kiorly-lab",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "LabPaymentRecorded"
    },
    "aggregateType": {
      "const": "Payment"
    },
    "data": {
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 1
        },
        "invoiceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "enum": [
            "CASH",
            "CARD"
          ]
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": [
        "paymentId",
        "invoiceId",
        "method",
        "amount",
        "currency"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
