{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/DispenseCompleted.schema.json",
  "title": "DispenseCompleted",
  "description": "Order dispensed to the patient. Pharmacist sign-off must be present (KPRX06).",
  "x-producer": "kiorly-pharmacy",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "DispenseCompleted"
    },
    "aggregateType": {
      "const": "PharmacyOrder"
    },
    "data": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "pharmacyId": {
          "type": "string",
          "minLength": 1
        },
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "dispensedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pharmacistSignoff": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "minLength": 1
            },
            "signedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "userId",
            "signedAt"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "description": "Per-line fulfilment (1.8.0). `sku` = the catalogue sku of the order line; `quantityDispensed` <= `quantityRequested`.",
          "items": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string",
                "minLength": 1
              },
              "quantityRequested": {
                "type": "integer",
                "minimum": 1
              },
              "quantityDispensed": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "sku",
              "quantityRequested",
              "quantityDispensed"
            ]
          }
        },
        "deliveryMade": {
          "type": "boolean",
          "description": "1.8.0: DELIVERY orders only. false = the pharmacy did not deliver (Kiorex refunds the delivery fee per the market policy). Absent = delivered / not applicable."
        }
      },
      "required": [
        "orderId",
        "pharmacyId",
        "dispensedAt",
        "pharmacistSignoff"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
