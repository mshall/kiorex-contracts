{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/LabInvoiceIssued.schema.json",
  "title": "LabInvoiceIssued",
  "description": "Lab invoice issued for a KIOREX_BOOKING order. Total is a decimal in major units of `currency`, VAT is a configurable line on the lab's own invoice (no tax-authority reporting).",
  "x-producer": "kiorly-lab",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "LabInvoiceIssued"
    },
    "aggregateType": {
      "const": "Invoice"
    },
    "data": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string",
          "minLength": 1
        },
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "invoiceId",
        "orderId",
        "currency",
        "total"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
