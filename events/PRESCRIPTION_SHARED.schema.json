{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/PRESCRIPTION_SHARED.schema.json",
  "title": "PRESCRIPTION_SHARED",
  "description": "Prescription of a signed encounter shared with the patient app after consent. Not in KX-09 §04.",
  "x-producer": "kiorly-clinic",
  "x-status": "kiorly-extra",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "PRESCRIPTION_SHARED"
    },
    "aggregateType": {
      "enum": [
        "Encounter",
        "Record"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "patientId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "PRESCRIPTIONS"
        },
        "encounterId": {
          "type": "string",
          "minLength": 1
        },
        "clinicId": {
          "type": "string",
          "minLength": 1
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pdf": {
          "type": "object",
          "description": "Signed expiring public link to the Rx PDF (additive, 1.1.0); fetch it into the patient vault before expiresAt.",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "url",
            "expiresAt"
          ]
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "patientId",
        "scope",
        "encounterId",
        "clinicId",
        "signedAt"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
