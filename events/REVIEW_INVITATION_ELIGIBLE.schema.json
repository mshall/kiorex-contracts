{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/REVIEW_INVITATION_ELIGIBLE.schema.json",
  "title": "REVIEW_INVITATION_ELIGIBLE",
  "description": "Completed Kiorex-channel visit is eligible for a verified-review invitation.",
  "x-producer": "kiorly-clinic",
  "x-status": "emitted",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "REVIEW_INVITATION_ELIGIBLE"
    },
    "aggregateType": {
      "const": "Appointment"
    },
    "data": {
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "minLength": 1
        },
        "clinicId": {
          "type": "string",
          "minLength": 1
        },
        "bookingSource": {
          "enum": [
            "FRONT_DESK",
            "PHONE",
            "WALK_IN",
            "CLINIC_LINK",
            "KIOREX_MARKETPLACE",
            "KIOREX_WHATSAPP",
            "INTEGRATION",
            "IMPORT"
          ]
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "appointmentId",
        "clinicId",
        "bookingSource"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
