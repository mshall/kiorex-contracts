{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/LoyaltyPointsConverted.schema.json",
  "title": "LoyaltyPointsConverted",
  "description": "INTERNAL. Points were converted into a reward lot of kind LOYALTY in the existing patient reward ledger (one transaction). The lot reference and its value are the only link; there is no cash, top-up or transfer path (work package P4-D).",
  "x-producer": "kiorex",
  "x-status": "v2-draft",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "LoyaltyPointsConverted"
    },
    "aggregateType": {
      "const": "LoyaltyAccount"
    },
    "data": {
      "type": "object",
      "properties": {
        "accountRef": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "points": {
          "type": "integer",
          "minimum": 1
        },
        "lotRef": {
          "type": "string",
          "minLength": 1
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        }
      },
      "required": [
        "accountRef",
        "points",
        "lotRef",
        "amountMinor",
        "currency",
        "at"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
