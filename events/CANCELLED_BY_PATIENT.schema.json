{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/events/CANCELLED_BY_PATIENT.schema.json",
  "title": "CANCELLED_BY_PATIENT",
  "description": "Appointment CANCELLED by the patient (Kiorex or Kiorly). depositRefundable reflects the cancellation-window policy.",
  "x-producer": "kiorly-clinic",
  "x-status": "emitted",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "CANCELLED_BY_PATIENT"
    },
    "aggregateType": {
      "const": "Appointment"
    },
    "data": {
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "minLength": 1
        },
        "clinicId": {
          "type": "string",
          "minLength": 1
        },
        "previousStatus": {
          "enum": [
            "SCHEDULED",
            "CONFIRMED",
            "CHECKED_IN",
            "COMPLETED",
            "CANCELLED",
            "NO_SHOW"
          ]
        },
        "nextStatus": {
          "const": "CANCELLED"
        },
        "bookingSource": {
          "enum": [
            "FRONT_DESK",
            "PHONE",
            "WALK_IN",
            "CLINIC_LINK",
            "KIOREX_MARKETPLACE",
            "KIOREX_WHATSAPP",
            "INTEGRATION",
            "IMPORT"
          ]
        },
        "externalReference": {
          "type": [
            "string",
            "null"
          ],
          "description": "Kiorex booking reference (kx_bk_...) for marketplace bookings."
        },
        "source": {
          "type": "string",
          "description": "e.g. waitlist_autofill"
        },
        "clinicianId": {
          "type": "string"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "endsAt": {
          "type": "string",
          "format": "date-time"
        },
        "isNewPatientAtBooking": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "acquisitionOrigin": {
          "enum": [
            "PROVIDER_LED",
            "MARKETPLACE",
            "UNATTRIBUTED"
          ],
          "description": "Commission-relevant acquisition origin decided by the Kiorex attribution function (additive in 1.10.0). Absent = UNATTRIBUTED and today's rules apply."
        },
        "aggregateType": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "aggregateId": {
          "type": "string",
          "description": "Injected by the Kiorly outbox; mirrors the envelope field."
        },
        "cancelledBy": {
          "enum": [
            "PATIENT"
          ]
        },
        "cancellationReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Shown to the patient. Required (min 3 chars) by Kiorly for clinic cancellations of Kiorex bookings."
        },
        "depositRefundable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Kiorex Pay refunds automatically when true (KXMPAY02)."
        }
      },
      "required": [
        "appointmentId",
        "clinicId",
        "previousStatus",
        "nextStatus",
        "bookingSource"
      ]
    }
  },
  "required": [
    "type",
    "aggregateType",
    "data"
  ]
}
