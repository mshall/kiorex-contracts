{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/growth-config/SEO_AUTOMATION.schema.json",
  "title": "Growth config: SEO_AUTOMATION",
  "description": "SEO quality gate, internal-link planner and Core Web Vitals budgets (GRW-P3-F). autoNoindex is false by default: a failed gate raises an ops item and SeoQualityGateFailed but never changes a page until a human switched it on (maker-checker). Added in 1.13.0. PROPOSED_DEFAULT until ratified. Unknown keys rejected.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "autoNoindex": {
      "type": "boolean",
      "description": "A failed blocking check makes the page noindex. PROPOSED_DEFAULT false."
    },
    "minUniqueWords": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "hub": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "city": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "district": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "care-district": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "city-hub": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "district-hub": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "same-day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "telemedicine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "doctor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "nurse": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "clinic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "pharmacy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        },
        "lab": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum unique words of visible text for the template"
        }
      }
    },
    "maxSimilarityPercent": {
      "type": "integer",
      "minimum": 30,
      "maximum": 100,
      "description": "Near-duplicate threshold against the parent hub or a sibling"
    },
    "shingleSize": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8,
      "description": "Shingle size of the similarity check"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Title length minimum (must be below max)"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "Title length maximum"
        }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Meta description length minimum (must be below max)"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "Meta description length maximum"
        }
      }
    },
    "blocking": {
      "type": "array",
      "items": {
        "enum": [
          "thin-content",
          "similarity",
          "parity-ar-en",
          "title-meta",
          "structured-data",
          "canonical",
          "hreflang",
          "orphan",
          "claims",
          "empty-page",
          "review-markup",
          "available-providers"
        ]
      },
      "uniqueItems": true,
      "description": "Checks whose failure makes a page noindex when autoNoindex is on; the others only warn"
    },
    "forbiddenClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[^<>]*$"
          }
        },
        "ar": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[^<>]*$"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPerPage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "Links"
        },
        "maxPerAnchorKind": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Cross-links per anchor kind"
        },
        "topDoctors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "Top doctors"
        },
        "clinicDoctors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "Clinic doctors"
        },
        "minAnchorVariety": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "relatedSpecialties": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,60}$"
            }
          }
        }
      }
    },
    "vitals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lcpMs": {
          "type": "number",
          "minimum": 500,
          "maximum": 10000
        },
        "inpMs": {
          "type": "number",
          "minimum": 50,
          "maximum": 2000
        },
        "cls": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tbtMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "perfScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "alertTargets": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[^<>]*$"
      }
    }
  }
}
