    "canonicalHost",
    "locales",
    "defaultLocale",
    "minLiveProviders",
    "minUniqueBlocks",
    "maxSiblingSimilarityPercent",
    "sitemapShardSize",
    "edgeCacheSeconds",
    "staleWhileRevalidateSeconds",
    "delistedGoneAfterDays",
    "reviewMarkupEnabled",
    "districtPagesEnabled"
  ]
