{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/growth-config/LIFECYCLE_POLICY.schema.json",
  "title": "Growth config: LIFECYCLE_POLICY",
  "description": "Patient lifecycle messaging policy (GRW-P2-E): message classes, frequency caps, quiet hours, journeys and allowlisted segments. Messaging relevant: two-person rule. Only MARKETING is subject to caps and the marketing gate. Added in contracts 1.12.0. Every default is PROPOSED_DEFAULT until the founder ratifies it. Unknown keys are rejected; secrets are never stored here, only secretRef names.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageClasses": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "TRANSACTIONAL",
          "SECURITY",
          "CLINICAL",
          "MARKETING"
        ]
      },
      "description": "Fixed set: TRANSACTIONAL, SECURITY, CLINICAL, MARKETING (AD-6)."
    },
    "frequencyCaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marketingPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "PROPOSED_DEFAULT 1."
        },
        "marketingPerWeek": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "PROPOSED_DEFAULT 3."
        }
      },
      "required": [
        "marketingPerDay",
        "marketingPerWeek"
      ]
    },
    "quietHours": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+/[A-Za-z_]+$"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ]
    },
    "journeys": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{1,47}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Journey on or off."
          },
          "messageClass": {
            "enum": [
              "TRANSACTIONAL",
              "SECURITY",
              "CLINICAL",
              "MARKETING"
            ]
          },
          "maxSteps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "enabled",
          "messageClass"
        ]
      }
    },
    "segments": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{1,47}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "enum": [
                "stage",
                "platform",
                "language",
                "city",
                "district",
                "registeredDaysAgo",
                "lastBookingDaysAgo",
                "hasDependants",
                "referralStatus"
              ]
            },
            "description": "Allowlisted non-clinical attributes only: never a specialty, provider or health attribute."
          }
        },
        "required": [
          "attributes"
        ]
      }
    },
    "holdoutBps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "description": "Share of eligible people kept out of non-essential journeys for measurement, in basis points. PROPOSED_DEFAULT 0."
    }
  },
  "required": [
    "messageClasses",
    "frequencyCaps",
    "quietHours",
    "journeys",
    "segments",
    "holdoutBps"
  ]
}
