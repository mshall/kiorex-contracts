{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kiorex.com/growth-config/REWARD_RULES.schema.json",
  "title": "Growth config: REWARD_RULES",
  "description": "Reward issuance rules (GRW-P2-B2): COUPON or CREDIT mode, amounts per role, expiry, caps and redemption limits. Rewards are funded by the platform marketing budget, never charged to providers and never change an attribution decision (AD-3). Money relevant: two-person rule and an announcement. Added in contracts 1.12.0. Every default is PROPOSED_DEFAULT until the founder ratifies it. Unknown keys are rejected; secrets are never stored here, only secretRef names.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "COUPON",
        "CREDIT"
      ],
      "description": "PROPOSED_DEFAULT COUPON (lower regulatory exposure). CREDIT needs counsel clearance."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referrerMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000,
          "description": "PROPOSED_DEFAULT 0 until pricing sets a deposit or fee (AD-4)."
        },
        "refereeMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "repeatMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "promoMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      },
      "required": [
        "referrerMinor",
        "refereeMinor",
        "repeatMinor",
        "promoMinor"
      ]
    },
    "expiryMonths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "description": "PROPOSED_DEFAULT 12."
    },
    "perUserAnnualCapMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "perCampaignCapMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000
    },
    "ruleBudgetCeilingMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000,
      "description": "Total this rule version may issue."
    },
    "redemptionMaxBp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Largest share of the deposit (basis points) a reward may pay. PROPOSED_DEFAULT 10000."
    },
    "minPayableMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "description": "Smallest amount the patient must still pay by card. PROPOSED_DEFAULT 0."
    },
    "postToPayLedger": {
      "type": "boolean",
      "description": "Post redemptions to the pay ledger (balanced PROMO_FUNDED posting). PROPOSED_DEFAULT false (finance decision)."
    },
    "reversalWindowDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365,
      "description": "A refund or cancellation of the qualifying booking inside this window reverses the reward. PROPOSED_DEFAULT 30."
    },
    "holdMaxDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "description": "A HOLD on a lot is released automatically after this many days without a decision. PROPOSED_DEFAULT 14."
    },
    "manualApprovalAboveMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "description": "Manual issuance above this needs a second approver. PROPOSED_DEFAULT 20000."
    },
    "manualDailyCapPerActorMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000,
      "description": "Manual issuance cap per actor per day. PROPOSED_DEFAULT 50000."
    },
    "issueOn": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "COMPLETED_VISIT",
          "COMPLETED_NTH_VISIT",
          "SUPPORT_APPROVED",
          "REFUND_CHOICE"
        ]
      },
      "description": "Verified events an issuance may follow. SIGNUP and BOOKING_CREATED are not valid values (safety rule S4). PROPOSED_DEFAULT [COMPLETED_VISIT]."
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "description": "PATIENT credit block (Rev 2.6, ADR-048 Proposed). Only meaningful in CREDIT mode behind the locked flags growth.patient_credit, growth.refund_as_credit and growth.family_credit.",
      "properties": {
        "maxOpenBalanceMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000,
          "description": "Maximum open balance per patient and per household. PROPOSED_DEFAULT 200000 (EGP 2,000), counsel to confirm."
        },
        "refundAsCredit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refundCreditExpiryMonths": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "refundCreditOnExpiry": {
              "enum": [
                "REFUND_TO_ORIGINAL",
                "FORFEIT"
              ],
              "description": "PROPOSED_DEFAULT REFUND_TO_ORIGINAL: it is the patient's own money."
            },
            "restoredLotMinDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "description": "A credit restored after a refund keeps at least this many days. PROPOSED_DEFAULT 90."
            }
          },
          "required": [
            "enabled",
            "refundCreditExpiryMonths",
            "refundCreditOnExpiry",
            "restoredLotMinDays"
          ]
        },
        "family": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "goodwill": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "PROVIDER_LATE_CANCEL",
                  "LONG_WAIT",
                  "FAILED_BOOKING",
                  "PAYMENT_ISSUE",
                  "OTHER_APPROVED"
                ]
              }
            },
            "perAgentDailyCapMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "perPatient90dCapMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "perReasonMaxMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "approvalAboveMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": [
            "reasons",
            "perAgentDailyCapMinor",
            "perPatient90dCapMinor",
            "perReasonMaxMinor",
            "approvalAboveMinor"
          ]
        },
        "campaignScope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceKinds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "IN_CLINIC",
                  "VIDEO",
                  "HOME_VISIT"
                ]
              }
            },
            "specialtyAllowlist": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,40}$"
              },
              "description": "Counsel-approved non-sensitive specialties where a campaign credit may be SPENT. A scope is never a targeting attribute."
            }
          },
          "required": [
            "serviceKinds"
          ]
        }
      },
      "required": [
        "maxOpenBalanceMinor"
      ]
    }
  },
  "required": [
    "mode",
    "currency",
    "amounts",
    "expiryMonths",
    "perUserAnnualCapMinor",
    "perCampaignCapMinor",
    "ruleBudgetCeilingMinor",
    "redemptionMaxBp",
    "minPayableMinor",
    "postToPayLedger"
  ]
}
