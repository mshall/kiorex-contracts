{
  "name": "@kiorex/contracts",
  "version": "1.10.0",
  "description": "Kiorex v2 integration contracts: OpenAPI specs, event JSON Schemas, feature-flag catalogue, HMAC helpers, flag evaluator (KX-09) and the shared notification layer (@kiorex/contracts/notify).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./notify": {
      "import": {
        "types": "./dist/notify.d.ts",
        "default": "./dist/notify.js"
      },
      "require": {
        "types": "./dist/notify.d.cts",
        "default": "./dist/notify.cjs"
      }
    },
    "./openapi/*": "./openapi/*",
    "./events/*": "./events/*",
    "./flags/*": "./flags/*",
    "./consumer/*": "./consumer/*",
    "./growth-config/*": "./src/growth-config/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi",
    "events",
    "flags",
    "consumer",
    "src/growth-config",
    "fixtures/growth-v1.10",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshall/kiorex-contracts.git"
  },
  "scripts": {
    "generate": "node scripts/generate-events.mjs && node scripts/generate-flags.mjs && node scripts/generate-growth.mjs && node scripts/generate-types.mjs",
    "build": "npm run generate && tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "pack:local": "npm run build && mkdir -p dist-pack && npm pack --pack-destination dist-pack",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.4.4",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "typesVersions": {
    "*": {
      "notify": [
        "./dist/notify.d.ts"
      ]
    }
  }
}
