{
  "openapi": "3.1.0",
  "x-status": "draft",
  "info": {
    "title": "Kiorly Lab Integration API (draft)",
    "version": "0.2.0",
    "description": "DRAFT (x-status: draft). Inbound order API of Kiorly Lab (kiorly-lab apps/api src/integration), mirrored from the code and Docs/NEEDS_HUMAN.md NH-LB-025; not frozen until the lab owner approves (NH-LB-023). Callers are Kiorex (KIOREX_BOOKING) and Kiorly Clinic lab-order handoff (KIORLY_CLINIC); the client's source is bound to its key. Outbound events are the Lab* schemas in events/. Requests are signed with the Kiorly HMAC scheme; no tax-authority reporting exists. 1.4.0: catalogue, quote and slots endpoints for the Kiorex marketplace (additive); the client key binds the tenant (no org header); outbox events go to Kiorex /api/v1/webhooks/lab signed with the webhook scheme + X-Kiorly-Client-Key."
  },
  "servers": [
    {
      "url": "http://localhost:3200/api/v1",
      "description": "Local Kiorly Lab"
    }
  ],
  "security": [
    {
      "kiorlyHmac": []
    }
  ],
  "paths": {
    "/integration/v1/orders": {
      "post": {
        "operationId": "labCreateOrder",
        "tags": [
          "integration"
        ],
        "summary": "Create (idempotent on sourceRef) a lab order from Kiorex or Kiorly Clinic",
        "description": "Replaying the same `sourceRef` for the same client returns the existing order with `created: false`. Unknown fields are rejected (strict). Flag lab.kiorex_bookings gates KIOREX_BOOKING orders.",
        "parameters": [
          {
            "name": "X-Kiorly-Client-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Integration client key (created by a lab owner via POST /integration-clients)."
          },
          {
            "name": "X-Kiorly-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix epoch MILLISECONDS."
          },
          {
            "name": "X-Kiorly-Nonce",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique per request; replays are rejected."
          },
          {
            "name": "X-Kiorly-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "HMAC-SHA256 over `ts\\nnonce\\nMETHOD\\npath\\nsha256(body)` (query string stripped); same scheme as kiorly-marketplace."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundLabOrder"
              },
              "example": {
                "sourceRef": "bk_01JF3ZG000",
                "labId": "lab_01JF3Z8AAA",
                "patient": {
                  "fullName": "Amira Samy",
                  "sex": "F",
                  "phone": "+201000000001",
                  "preferredLocale": "ar"
                },
                "testCodes": [
                  "CBC"
                ],
                "priority": "ROUTINE",
                "collection": {
                  "type": "HOME",
                  "address": "12 Nile St, Cairo",
                  "windowStart": "2027-03-06T08:00:00.000Z",
                  "windowEnd": "2027-03-06T10:00:00.000Z",
                  "contactPhone": "+201000000001"
                },
                "consentChannels": [
                  "KIOREX_VAULT"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundLabOrderResult"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED {issues[]}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CLIENT | INVALID_SIGNATURE | REPLAYED_NONCE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
