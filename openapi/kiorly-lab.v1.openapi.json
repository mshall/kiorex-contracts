  "components": {
    "securitySchemes": {
      "kiorlyHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kiorly-Signature",
        "description": "See operation header parameters."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": true
      },
      "LabOrderStatusEnum": {
        "type": "string",
        "enum": [
          "DRAFT",
          "AWAITING_COLLECTION",
          "COLLECTED",
          "IN_LAB",
          "PARTIALLY_RESULTED",
          "AWAITING_VALIDATION",
          "VALIDATED",
          "RELEASED",
          "CANCELLED"
        ]
      },
      "InboundLabOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRef",
          "patient"
        ],
        "properties": {
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "labId": {
            "type": "string"
          },
          "patient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fullName"
            ],
            "properties": {
              "fullName": {
                "type": "string",
                "minLength": 2
              },
              "dateOfBirth": {
                "type": "string"
              },
              "sex": {
                "type": "string",
                "enum": [
                  "M",
                  "F",
                  "OTHER",
                  "UNKNOWN"
                ]
              },
              "phone": {
                "type": "string"
              },
              "externalId": {
                "type": "string"
              },
              "preferredLocale": {
                "type": "string",
                "enum": [
                  "ar",
                  "en"
                ]
              }
            }
          },
          "testCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packageCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "ROUTINE",
              "URGENT",
              "STAT"
            ]
          },
          "referringDoctor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          },
          "collection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "IN_LAB",
                  "HOME"
                ]
              },
              "address": {
                "type": "string"
              },
              "windowStart": {
                "type": "string",
                "format": "date-time"
              },
              "windowEnd": {
                "type": "string",
                "format": "date-time"
              },
              "geo": {
                "type": "object",
                "required": [
                  "lat",
                  "lng"
                ],
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  }
                }
              },
              "contactPhone": {
                "type": "string"
              }
            }
          },
          "consentChannels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PRINTED",
                "PATIENT_LINK_OTP",
