    "/integration/v1/orders/{sourceRef}/custody": {
      "get": {
        "operationId": "labGetOrderCustody",
        "tags": [
          "integration"
        ],
        "summary": "Chain of custody for an order the caller placed (KIORLY_NURSE / KIORLY_CLINIC clients only)",
        "description": "Event type, time, temperature and who (NURSE | LAB) per specimen. Never staff names, never PHI. 404 NOT_AVAILABLE_FOR_CLIENT for a Kiorex booking client; 404 ORDER_NOT_FOUND for another client's order.",
        "parameters": [
          {
            "name": "X-Kiorly-Client-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Integration client key (created by a lab owner via POST /integration-clients)."
          },
          {
            "name": "X-Kiorly-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix epoch MILLISECONDS."
          },
          {
            "name": "X-Kiorly-Nonce",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique per request; replays are rejected."
          },
          {
            "name": "X-Kiorly-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "HMAC-SHA256 over `ts\\nnonce\\nMETHOD\\npath\\nsha256(body)` (query string stripped); same scheme as kiorly-marketplace."
          },
          {
            "name": "sourceRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Custody",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabOrderCustody"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CLIENT | INVALID_SIGNATURE | REPLAYED_NONCE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "ORDER_NOT_FOUND | NOT_AVAILABLE_FOR_CLIENT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "kiorlyHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kiorly-Signature",
        "description": "See operation header parameters."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": true
      },
      "LabOrderStatusEnum": {
        "type": "string",
        "enum": [
          "DRAFT",
          "AWAITING_COLLECTION",
          "COLLECTED",
          "IN_LAB",
          "PARTIALLY_RESULTED",
          "AWAITING_VALIDATION",
          "VALIDATED",
          "RELEASED",
          "CANCELLED"
        ]
      },
      "InboundLabOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRef",
          "patient"
        ],
        "properties": {
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "labId": {
            "type": "string"
          },
          "patient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fullName"
            ],
            "properties": {
              "fullName": {
                "type": "string",
                "minLength": 2
              },
              "dateOfBirth": {
                "type": "string"
              },
              "sex": {
                "type": "string",
                "enum": [
                  "M",
                  "F",
                  "OTHER",
                  "UNKNOWN"
                ]
              },
              "phone": {
                "type": "string"
              },
              "externalId": {
                "type": "string"
              },
              "preferredLocale": {
                "type": "string",
                "enum": [
                  "ar",
                  "en"
                ]
              }
            }
          },
          "testCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packageCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "ROUTINE",
              "URGENT",
              "STAT"
            ]
          },
          "referringDoctor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          },
          "collection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "IN_LAB",
                  "HOME"
                ]
              },
              "address": {
                "type": "string"
              },
              "windowStart": {
                "type": "string",
                "format": "date-time"
              },
              "windowEnd": {
                "type": "string",
                "format": "date-time"
              },
              "geo": {
                "type": "object",
                "required": [
                  "lat",
                  "lng"
                ],
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  }
                }
              },
              "contactPhone": {
                "type": "string"
              },
              "districtId": {
                "type": "string",
                "description": "Coarse district code for HOME collections (coverage check); never a full address in events."
              }
            }
          },
          "consentChannels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PRINTED",
                "PATIENT_LINK_OTP",
                "KIORLY_CLINIC_IMPORT",
                "KIORLY_NURSE_IMPORT",
                "KIOREX_VAULT"
              ]
            },
            "description": "Result-release consent; with none recorded nothing is released on any channel."
          },
          "identifiersChecked": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "description": "KLORD05: kinds of the two identifiers the nurse verified at collection (e.g. FULL_NAME, DATE_OF_BIRTH, PHONE, MRN). Kinds only, never the values."
          },
          "nurseCollection": {
            "$ref": "#/components/schemas/NurseCollection"
          }
        },
        "description": "Strict inbound order (unknown fields are rejected). `nurseCollection` is accepted only from a KIORLY_NURSE client (and is required from it); `identifiersChecked` (>= 2 kinds, never values) is required with it."
      },
      "InboundLabOrderResult": {
        "type": "object",
        "required": [
          "orderId",
          "orderNumber",
          "status",
          "created"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "orderNumber": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/LabOrderStatusEnum"
          },
          "created": {
            "type": "boolean"
          }
        }
      },
      "LabOrderStatus": {
        "type": "object",
        "required": [
          "id",
          "orderNumber",
          "status",
          "collectionType"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "orderNumber": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/LabOrderStatusEnum"
          },
          "collectionType": {
            "type": "string",
            "enum": [
              "IN_LAB",
              "HOME"
            ]
          }
        }
      },
      "LabList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "homeCollection": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "TestList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "labId": {
                  "type": "string"
                },
                "labName": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "priceMinor": {
                  "type": "integer"
                },
                "sampleType": {
                  "type": "string"
                },
                "homeCollection": {
                  "type": "boolean"
                },
                "preparation": {
                  "type": "string"
                }
              },
              "required": [
                "labId",
                "code",
                "name",
                "priceMinor"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "LabQuoteRequest": {
        "type": "object",
        "properties": {
          "labId": {
            "type": "string"
          },
          "testCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "collectionType": {
            "type": "string",
            "enum": [
              "HOME",
              "WALK_IN"
            ]
          }
        },
        "required": [
          "testCodes"
        ]
      },
      "LabQuote": {
        "type": "object",
        "properties": {
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "priceMinor": {
                  "type": "integer"
                }
              },
              "required": [
                "code",
                "name",
                "priceMinor"
              ]
            }
          },
          "collectionFeeMinor": {
            "type": "integer"
          }
        },
        "required": [
          "tests",
          "collectionFeeMinor"
        ]
      },
      "LabSlots": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startsAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "endsAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "available": {
                  "type": "integer"
                }
              },
              "required": [
                "startsAt",
                "endsAt"
              ]
            }
          }
        },
        "required": [
          "slots"
        ]
      },
      "NurseCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "visitRef",
          "collectorRef",
          "collectedAt",
          "consentToken",
          "samples"
        ],
        "description": "A sample the nurse already collected (KNLAB01). The tube label becomes the specimen barcode; chain of custody starts at `collectedAt`. The consent token is the patient's LAB_RESULTS record-share grant (the lab stores only its SHA-256).",
        "properties": {
          "visitRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "collectorRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Opaque collector reference; never a phone number or national id."
          },
          "collectorName": {
            "type": "string",
            "maxLength": 160
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Not in the future."
          },
          "handedOverAt": {
            "type": "string",
            "format": "date-time",
            "description": "Between collectedAt and now."
          },
          "temperatureC": {
            "type": "number",
            "minimum": -40,
            "maximum": 60
          },
          "consentToken": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "specimenType"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "^[\\x21-\\x7e]{3,40}$",
                  "description": "Tube label / barcode, 3-40 printable ASCII, unique per lab."
                },
                "specimenType": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 60
                },
                "container": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            }
          }
        }
      },
      "LabOrderCustody": {
        "type": "object",
        "required": [
          "sourceRef",
          "orderNumber",
          "status",
          "specimens"
        ],
        "properties": {
          "sourceRef": {
            "type": "string"
          },
          "orderNumber": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/LabOrderStatusEnum"
          },
          "collectedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "receivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "specimens": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "status",
                "custody"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "accessionNumber": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "custody": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "occurredAt",
                      "by"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "COLLECTED | TRANSPORT_STARTED | RECEIVED | LABEL_MISMATCH_BLOCKED | ..."
                      },
                      "occurredAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "by": {
                        "type": "string",
                        "enum": [
                          "NURSE",
                          "LAB"
                        ]
                      },
                      "temperatureC": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "location": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "x-client-sources": [
    "KIOREX_BOOKING",
    "KIORLY_CLINIC",
    "KIORLY_NURSE"
  ]
}
