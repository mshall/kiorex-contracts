    "/marketplace/v1/orders": {
      "post": {
        "operationId": "pharmacyCreateOrder",
        "tags": [
          "marketplace-v1"
        ],
        "summary": "Order intent (after payment capture)",
        "description": "Idempotent on orderId. 409 BRANCH_NOT_OPTED_IN | PRICE_CHANGED, 422 UNKNOWN_SKU | CONTROLLED_NOT_ORDERABLE | PRESCRIPTION_REQUIRED. Pharmacy then emits OrderReady / DispenseCompleted / OrderRejected.",
        "parameters": [
          {
            "name": "X-Kiorly-Client-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Partner integration client key. Binds the request to ONE partner organisation (tenant): there is no org header (NH-PH-024 resolved)."
          },
          {
            "name": "X-Kiorly-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix epoch MILLISECONDS."
          },
          {
            "name": "X-Kiorly-Nonce",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique per request; replays are rejected."
          },
          {
            "name": "X-Kiorly-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "base64url HMAC-SHA256(secret, `ts\\nnonce\\nMETHOD\\npath\\nsha256(body)`), path WITHOUT query string and WITH any prefix, e.g. /marketplace/v1/orders."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Kiorex order id; the order is also idempotent on its orderId."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderIntent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CLIENT | HMAC_REJECTED (bad signature, stale timestamp, replayed nonce)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FEATURE_DISABLED {key,scope} (pharmacy.kiorex_orders)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResult"
                }
              }
            }
          }
        }
      }
    },
