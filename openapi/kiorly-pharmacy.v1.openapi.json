  },
  "components": {
    "securitySchemes": {
      "kiorlyHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kiorly-Signature"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Pharmacy": {
        "type": "object",
        "description": "One opted-in branch. `id` is the branch id (Kiorex `pharmacyId`).",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "delivery": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "feeMinor": {
                "type": "integer"
              },
              "radiusKm": {
                "type": "number"
              }
            },
            "required": [
              "enabled",
              "feeMinor"
            ]
          },
          "pickup": {
            "type": "boolean"
          },
          "prepMinutes": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "delivery",
          "pickup"
        ]
      },
      "CatalogueItem": {
        "type": "object",
        "description": "Controlled medicines are NEVER listed (KPRX05). Prices are minor units (EGP piastres).",
        "properties": {
          "pharmacyId": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          },
          "form": {
            "type": "string"
          },
          "priceMinor": {
            "type": "integer"
          },
          "rxRequired": {
            "type": "boolean"
          },
          "controlled": {
            "type": "boolean",
            "const": false
          },
          "available": {
            "type": "boolean"
          },
          "availableQty": {
            "type": "integer"
          }
        },
        "required": [
          "pharmacyId",
          "sku",
          "name",
          "priceMinor",
          "rxRequired",
          "available"
        ]
      },
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "pharmacyId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "sku",
                "qty"
              ]
            }
          },
          "delivery": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "PICKUP",
                  "DELIVERY"
                ]
              }
            }
          }
        },
        "required": [
          "pharmacyId",
          "items"
        ]
      },
      "Quote": {
        "type": "object",
        "description": "Authoritative price/availability: the pharmacy is the price authority, Kiorex never trusts client prices.",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "unitPriceMinor": {
                  "type": "integer"
                },
                "rxRequired": {
                  "type": "boolean"
                },
                "controlled": {
                  "type": "boolean"
                },
                "available": {
                  "type": "boolean"
                }
              },
              "required": [
                "sku",
                "qty",
                "unitPriceMinor",
                "rxRequired",
                "controlled",
                "available"
              ]
            }
          },
          "delivery": {
            "type": "object",
            "properties": {
              "feeMinor": {
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "OrderIntent": {
        "type": "object",
        "description": "Created by Kiorex AFTER Kiorex Pay captured the payment. Idempotent on orderId (= Kiorex order id = Idempotency-Key): a replay returns the original result with replayed:true. Unit prices must equal the pharmacy's own price book (else 409 PRICE_CHANGED). Rx-only lines need `prescription` (recordRef + verificationToken, or prescriberName for an uploaded scan).",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "branchId": {
            "type": "string",
            "description": "= Pharmacy.id"
          },
          "patientRef": {
            "type": "string"
          },
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "prepaid": {
            "type": "boolean"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "unitPrice": {
                  "type": "string",
                  "description": "Decimal MAJOR units, e.g. \"12.50\" (the pharmacy ledger unit)."
                }
              },
              "required": [
                "sku",
                "quantity",
                "unitPrice"
              ]
            }
          },
          "delivery": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "PICKUP",
                  "DELIVERY"
                ]
              },
              "address": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "payment": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string"
              },
              "totalMinor": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              }
            }
          },
          "prescription": {
            "type": "object",
            "properties": {
              "recordRef": {
                "type": "string"
              },
              "verificationToken": {
                "type": "string",
                "description": "Kiorex opaque Rx token; the pharmacy verifies it with Kiorex GET /api/v1/rx/verify?t="
              },
              "patientRef": {
                "type": "string"
              },
              "prescriberName": {
                "type": "string"
              },
              "prescriberLicenceNo": {
                "type": "string"
              },
              "issuedAt": {
                "type": "string",
                "format": "date-time"
              },
              "scanRef": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "orderId",
          "branchId",
          "lines"
        ]
      },
      "OrderResult": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "ACCEPTED",
              "PARTIALLY_ACCEPTED",
              "READY",
              "DISPENSED",
              "REJECTED",
              "CANCELLED",
              "EXPIRED"
            ]
          },
          "slaDueAt": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "orderId",
          "status"
        ]
      },
      "RxValidateRequest": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "prescriptionRef": {
            "type": "string"
          },
          "verificationToken": {
            "type": "string"
          },
          "patientRef": {
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "prescriptionRef",
          "verificationToken"
        ]
      },
      "RxValidateResult": {
        "type": "object",
        "description": "VALID only after a pharmacist validated the prescription (KPMKT04); PENDING while that is outstanding; INVALID when Kiorex rejects the token (the order is then rejected and OrderRejected is emitted).",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "VALID",
              "INVALID",
              "PENDING"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "CancelRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
