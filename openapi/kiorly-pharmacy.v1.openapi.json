            "schema": {
              "type": "string"
            },
            "description": "base64url HMAC-SHA256(secret, `ts\\nnonce\\nMETHOD\\npath\\nsha256(body)`), path WITHOUT query string and WITH any prefix, e.g. /marketplace/v1/orders."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RxValidateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RxValidateResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
