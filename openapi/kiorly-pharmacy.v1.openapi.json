{
  "openapi": "3.1.0",
  "x-status": "draft",
  "info": {
    "title": "Kiorly Pharmacy Marketplace API (draft)",
    "version": "0.1.0",
    "description": "Kiorex -> Kiorly Pharmacy machine API (kiorly-pharmacy apps/api src/modules/marketplace), reconciled in 1.4.0 against the running services (NH-PH-024, NH-023). Auth: Kiorly HMAC request scheme with a per-pharmacy integration client key (the key IS the tenant address, no X-Kiorex-Org-Id). Pharmacy -> Kiorex events (OrderReady, DispenseCompleted, OrderRejected) are signed with the webhook scheme plus X-Kiorly-Client-Key and posted to Kiorex /api/v1/webhooks/pharmacy. Money: Kiorex Pay captures first; OrderRejected triggers a full refund; partial dispense parks in PARTIAL_REVIEW. No tax-authority reporting."
  },
  "servers": [
    {
      "url": "http://localhost:3100",
      "description": "Local Kiorly Pharmacy (paths are NOT under /api/v1)"
    }
  ],
  "security": [
    {
      "kiorlyHmac": []
    }
  ],
  "paths": {
    "/marketplace/v1/pharmacies": {
      "get": {
        "operationId": "pharmacyListPharmacies",
        "tags": [
          "marketplace-v1"
        ],
        "summary": "Opted-in branches (KPMKT01)",
        "description": "Branches that opted into Kiorex orders with delivery options.",
        "parameters": [
          {
            "name": "X-Kiorly-Client-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Partner integration client key. Binds the request to ONE partner organisation (tenant): there is no org header (NH-PH-024 resolved)."
          },
          {
            "name": "X-Kiorly-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix epoch MILLISECONDS."
          },
          {
            "name": "X-Kiorly-Nonce",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique per request; replays are rejected."
          },
          {
            "name": "X-Kiorly-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "base64url HMAC-SHA256(secret, `ts\\nnonce\\nMETHOD\\npath\\nsha256(body)`), path WITHOUT query string and WITH any prefix, e.g. /marketplace/v1/orders."
          }
        ],
        "responses": {
          "200": {
            "description": "Branches"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CLIENT | HMAC_REJECTED (bad signature, stale timestamp, replayed nonce)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FEATURE_DISABLED {key,scope} (pharmacy.kiorex_orders)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/marketplace/v1/catalogue": {
